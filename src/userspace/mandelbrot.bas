10 REM Mandelbrot set - full screen (fixed point, scale 1000)
20 REM run with:  basic /mnt/cdrom/apps/mandelbrot.bas
30 CLS
40 SW=XMAX+1:SH=YMAX+1
50 GW=128:GH=80
60 FOR GY=0 TO GH-1
70 FOR GX=0 TO GW-1
80 CX=-2200+GX*3000/GW
90 CY=-1200+GY*2400/GH
100 ZX=0:ZY=0:I=0
110 X2=ZX*ZX/1000:Y2=ZY*ZY/1000
120 IF X2+Y2>4000 THEN 170
130 ZY=2*ZX*ZY/1000+CY
140 ZX=X2-Y2+CX
150 I=I+1
160 IF I<20 THEN 110
170 PX=GX*SW/GW:PY=GY*SH/GH
180 QX=(GX+1)*SW/GW-1:QY=(GY+1)*SH/GH-1
190 IF I>=20 THEN RECT PX,PY,QX,QY,0
200 IF I<20 THEN RECT PX,PY,QX,QY,1+(I MOD 15)
210 NEXT GX
220 NEXT GY
230 PRINT "DONE"
