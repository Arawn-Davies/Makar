10 REM Mandelbrot set - Makar BASIC (fixed point, scale 1000)
20 REM run with:  basic /mnt/cdrom/apps/mandelbrot.bas
30 CLS
40 FOR PY=0 TO 120
50 FOR PX=0 TO 180
60 CX=-2200+PX*16
70 CY=-1200+PY*20
80 ZX=0:ZY=0:I=0
90 X2=ZX*ZX/1000:Y2=ZY*ZY/1000
100 IF X2+Y2>4000 THEN 150
110 ZY=2*ZX*ZY/1000+CY
120 ZX=X2-Y2+CX
130 I=I+1
140 IF I<20 THEN 90
150 IF I>=20 THEN PLOT PX,PY,0
160 IF I<20 THEN PLOT PX,PY,1+(I MOD 15)
170 NEXT PX
180 NEXT PY
190 PRINT "DONE - PRESS A KEY"
