# Build outputs
*.iso
*.img
*.qcow2
_site/
isodir
sysroot

# ccache directory (mounted into the build container)
.ccache/

# Compiled kernel binary
*.kernel

# Test and serial logs
*.log

# Python cache
*.pyc
tests/groups/__pycache__/

# OS cruft
.DS_Store

# Compiled binary artifacts (no extension) that appear in arch dirs
src/kernel/arch/*/dt_asm

# Userspace build artefacts
src/userspace/*.o
src/userspace/*.a
src/userspace/*.elf
src/userspace/.tcc.stamp

# Vendored TCC build artefacts (NOT build-stubs -- those are
# hand-written Makar-flavoured headers, source of truth for the
# in-OS TCC sysroot.  Without them build-tcc.sh fails at stage time
# with "cannot stat .../build-stubs/limits.h".)
vendor/tinycc/build-tcc.log
vendor/tinycc/*.o
vendor/tinycc/lib/*.o
vendor/tinycc/lib/*.a
vendor/tinycc/config.h
